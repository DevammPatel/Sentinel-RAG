# Copy to .env and fill in what you need. With nothing set, the app still runs:
# it answers by quoting source passages (extractive mode) instead of calling an LLM.

# ---- LLM provider: groq | gemini | openai | anthropic | none ----
# groq and gemini have free tiers; openai and anthropic are paid.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- Retrieval (local ONNX models, no key needed) ----
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANKER_ONNX_FILE=onnx/model_int8.onnx
RETRIEVE_TOP_K=20
RERANK_TOP_N=5
MIN_CONTEXT_SCORE=0.4

# ---- Index storage: memory (files in data/index) | pgvector ----
VECTOR_BACKEND=memory
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# ---- API hardening ----
# Ingest endpoints only exist when ADMIN_TOKEN is set.
ADMIN_TOKEN=
RATE_LIMIT_PER_MINUTE=8
RATE_LIMIT_PER_DAY=150
GLOBAL_DAILY_LIMIT=1200
# Set true when running behind a reverse proxy (hosted platforms).
TRUST_PROXY_HEADERS=false
PROXY_HOPS=1
# Let callers pick the LLM provider per request. Keep false on a public deployment.
ALLOW_PROVIDER_OVERRIDE=false

# ---- Performance ----
# Threads per ONNX model. Leave unset to use the CPUs the container is allowed.
# ONNX_THREADS=2

# ---- Tracing (off by default) ----
TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006/v1/traces
