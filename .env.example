# ==========================================================================
# Provider selection (provider-configurable) --------------------------------
# ==========================================================================
# Which LLM backend to use for generation: "anthropic" or "openai"
LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-4o-mini

# API keys (only the one for the selected provider is strictly required)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Generation controls
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# ==========================================================================
# Embeddings ----------------------------------------------------------------
# ==========================================================================
# "openai" (text-embedding-3-small) or "local" (sentence-transformers, no key)
EMBEDDINGS_PROVIDER=local
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# ==========================================================================
# Reranking -----------------------------------------------------------------
# ==========================================================================
RERANKER_MODEL=BAAI/bge-reranker-base
RERANK_TOP_N=5

# ==========================================================================
# Retrieval -----------------------------------------------------------------
# ==========================================================================
RETRIEVE_TOP_K=20        # candidates per retriever before fusion
RRF_K=60                 # reciprocal-rank-fusion constant
CHUNK_SIZE=900           # target characters per chunk
CHUNK_OVERLAP=150

# ==========================================================================
# Postgres / pgvector -------------------------------------------------------
# ==========================================================================
PGHOST=localhost
PGPORT=5432
PGDATABASE=ragsys
PGUSER=ragsys
PGPASSWORD=ragsys

# ==========================================================================
# Observability (OpenTelemetry / OpenInference) -----------------------------
# ==========================================================================
# Set TRACING_ENABLED=false to disable all tracing.
TRACING_ENABLED=true
# Where OTLP spans are shipped. Phoenix local default below.
#   Phoenix:   http://localhost:6006/v1/traces
#   LangSmith: https://api.smith.langchain.com/otel/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006/v1/traces
OTEL_SERVICE_NAME=agentic-rag
# For LangSmith, also set these (headers passed straight through OTLP):
# OTEL_EXPORTER_OTLP_HEADERS=x-api-key=<LANGSMITH_API_KEY>,Langsmith-Project=agentic-rag
LANGSMITH_API_KEY=

# ==========================================================================
# Guardrails ----------------------------------------------------------------
# ==========================================================================
MIN_CONTEXT_SCORE=0.15   # below this the answer is refused (no grounded context)
MAX_INPUT_CHARS=4000
